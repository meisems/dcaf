# Local development only: copy to .dev.vars (wrangler dev) or .env (node runner).
# In production these are set in the Worker's Settings → Variables and Secrets (see DEPLOY.md).

# ---- chain ----
NEAR_NETWORK=mainnet
# your NEP-141 token
TOKEN_CONTRACT=dcaf.tkn.near
TOKEN_SYMBOL=DCAF
# block to start indexing from (empty = start at the current head)
START_BLOCK=
# contracts whose transfers count as buys/sells (comma separated)
DEX_ACCOUNTS=v2.ref-finance.near
REF_CONTRACT=v2.ref-finance.near
# Ref/Rhea pool id of TOKEN/wNEAR, used for spot price
REF_POOL_ID=
# accounts that never count as DCAers (comma separated)
EXCLUDE_ACCOUNTS=

# ---- vault ----
VAULT_ACCOUNT=vault.dcaf.near
# full-access or function-call key for the vault. Leave empty for a dry run (nothing is sent).
VAULT_PRIVATE_KEY=
# NEAR always kept in the vault for gas and storage
VAULT_RESERVE_NEAR=0.5

# ---- rules (defaults shown) ----
FEE_BPS=300
VAULT_BPS=100
TOP_N=10
MIN_BUY=0.1
MIN_TOTAL=1
ROUND_MIN=10
ROUND_MAX=15

# ---- infra ----
CORS_ORIGIN=*
# optional, raises neardata/RPC rate limits
FASTNEAR_API_KEY=
