# Every setting the engine reads. In production, add them in Cloudflare:
#   Workers & Pages → dcaf → Settings → Variables and Secrets → Add
# Type "Secret" ones as Secret, everything else as Text. Locally, copy this to .dev.vars (wrangler dev) or .env.
#
# A value written as <something> is a placeholder and counts as NOT set, so you can add the whole
# list now and fill in real values later. Until TOKEN_CONTRACT is real, the engine runs in test mode.

# ================= token (Text) =================
TOKEN_CONTRACT=<your-token-contract>          # e.g. dca.tkn.near: from your launchpad, or the token page on nearblocks.io
TOKEN_SYMBOL=DCA
START_BLOCK=<launch-block-height>             # block of the tx that created the token (nearblocks.io)
REF_POOL_ID=<rhea-dca-wnear-pool-id>          # optional: the number in the pool's address on app.rhea.finance

# ================= vault and rewards =================
VAULT_ACCOUNT=<your-vault-account>            # Text. A dedicated account that sends payouts
FEE_ACCOUNT=<fee-claim-wallet>                # Text, optional. The wallet you claim fees into (default: VAULT_ACCOUNT)
REWARD_SHARE=<0-to-1>                         # SECRET, required with a real token: part of every fee claim that goes to DCAers
VAULT_PRIVATE_KEY=<ed25519:vault-full-access-key>  # SECRET. Leave as a placeholder for a dry run (nothing is sent)
EXCLUDE_ACCOUNTS=<team-and-treasury-wallets>  # Text, optional, comma separated: never counted as DCAers
VAULT_RESERVE_NEAR=0.5                        # Text. NEAR always kept in the vault for gas and storage
DRY_RUN=false                                 # Text. true = never send, even with a key

# ================= RPC =================
# Reads: these private endpoints first (fastest healthy one), the public NEAR endpoints as the fallback.
# Payouts: Lava → dRPC → PRIVATE_RPC_URLS, in that order. Keys live inside the URLs, so make these SECRETS.
LAVA_RPC_URL=<lava-near-mainnet-https-url>    # SECRET. Lava gateway → project → NEAR mainnet → HTTPS endpoint
DRPC_RPC_URL=<drpc-near-https-url>            # SECRET. dRPC dashboard → key → NEAR → HTTPS endpoint
PRIVATE_RPC_URLS=<getblock-near-mainnet-url>  # SECRET. GetBlock → NEAR mainnet JSON-RPC endpoint (comma separate more)
FASTNEAR_API_KEY=<fastnear-api-key>           # SECRET, optional: higher rate limits on the FastNEAR transaction API
TX_PUBLIC_FALLBACK=true                       # Text. Broadcast a signed payout through public RPCs if all private ones are down
# RPC_URLS=                                   # Text, optional: replaces the built-in public read list
# RPC_URL=                                    # Text, optional: adds one public endpoint in front of it

# ================= rules (Text, defaults shown) =================
MIN_HOLDERS=15
ROUND_MIN=10
ROUND_MAX=15
MIN_BUY=0.1
MIN_TOTAL=1
TOP_N=0
EQUAL_SHARE=0.5
MAX_SHARE=0.25
MIN_PAYOUT=0.001

# ================= advanced (leave unset) =================
# NEAR_NETWORK=mainnet
# DEX_ACCOUNTS=v2.ref-finance.near,dclv2.ref-labs.near,aggregatedex.near
# REF_CONTRACT=v2.ref-finance.near
# WRAP_CONTRACT=wrap.near
# TX_API_URL=https://tx.main.fastnear.com
# LIVE_LAG_SEC=30
# CORS_ORIGIN=*
# local runner only: PORT=8787  DB_PATH=./data/dcaf.db  STATIC_DIR=../dist
