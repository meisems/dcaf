{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true
  },
  "include": ["src/worker.ts", "src/config.ts", "src/db.ts", "src/engine.ts", "src/indexer.ts", "src/market.ts", "src/near.ts", "src/payouts.ts", "src/read.ts", "src/routes.ts", "../shared"]
}
