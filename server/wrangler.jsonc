// Cloudflare Worker for the dcainnear engine. Deployed by Workers Builds from GitHub (no CLI needed):
// Workers & Pages → Create → Import a repository → root directory "server".
//
// "vars" below are the engine's Text settings. Every deploy writes them to the Worker, so they show up in
// the dashboard (Settings → Variables and Secrets) and THIS FILE is where to change them: an edit made in the
// dashboard is replaced on the next deploy. A value written as <something> is a placeholder and counts as
// not set (until TOKEN_CONTRACT is real the engine runs in test mode).
// Secrets (REWARD_SHARE, VAULT_PRIVATE_KEY, the RPC URLs, FASTNEAR_API_KEY) never go here: add them in the
// dashboard as Secrets. keep_vars keeps them, and anything else set there, on every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcaf",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    // token
    "TOKEN_CONTRACT": "<your-token-contract>",
    "TOKEN_SYMBOL": "DCA",
    "START_BLOCK": "<launch-block-height>",
    "REF_POOL_ID": "<rhea-dca-wnear-pool-id>",
    // vault and rewards
    "VAULT_ACCOUNT": "<your-vault-account>",
    "FEE_ACCOUNT": "<fee-claim-wallet>",
    "EXCLUDE_ACCOUNTS": "<team-and-treasury-wallets>",
    "VAULT_RESERVE_NEAR": "0.5",
    "DRY_RUN": "false",
    "TX_PUBLIC_FALLBACK": "true",
    // rules
    "MIN_HOLDERS": "15",
    "ROUND_MIN": "10",
    "ROUND_MAX": "15",
    "MIN_BUY": "0.1",
    "MIN_TOTAL": "1",
    "TOP_N": "0",
    "EQUAL_SHARE": "0.5",
    "MAX_SHARE": "0.25",
    "MIN_PAYOUT": "0.001",
    // change to any new value and deploy to wipe the engine's data once and start over
    "RESET_ID": "2026-10-05-test-reset"
  },
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "EngineDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EngineDO"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
