# Every setting the website reads. Production values live in wrangler.jsonc ("vars"), which Pages shows in
# Settings → Variables and Secrets. Locally, a .env.local value wins over it.
# Locally, copy this to .env.local. A value written as <something> is a placeholder and counts as not set.

VITE_TOKEN_CONTRACT=<your-token-contract>     # same as the Worker's TOKEN_CONTRACT (Buy button, token links)
VITE_TOKEN_SYMBOL=DCA
VITE_NEAR_NETWORK=mainnet                     # mainnet or testnet
VITE_BUY_URL=<custom-buy-link>                # optional; {token} is replaced. Default: the Rhea swap page
VITE_TWITTER_URL=<x-profile-url>              # optional
VITE_TELEGRAM_URL=<telegram-url>              # optional
VITE_API_URL=                                 # empty: /api goes to the engine through the site. Locally: https://dcaf.laidev.workers.dev

# Pages Function (runtime, not build): only if the engine moves away from https://dcaf.laidev.workers.dev
# ENGINE_URL=<engine-worker-url>
# or, better: Settings → Bindings → Service binding, variable ENGINE → service dcaf
