# The website's settings, built into every production build (Cloudflare Pages runs `npm run build`).
# Change them here and push. A variable set in the Pages dashboard (Settings → Variables and Secrets)
# overrides the same name here. A value written as <something> is a placeholder and counts as not set.
VITE_TOKEN_CONTRACT=<your-token-contract>
VITE_TOKEN_SYMBOL=DCA
VITE_BUY_URL=<custom-buy-link>
VITE_TWITTER_URL=<x-profile-url>
VITE_TELEGRAM_URL=<telegram-url>
