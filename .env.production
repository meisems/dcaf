# Every setting the website reads, built into each production build (Cloudflare Pages runs `npm run build`).
# Change them here and push. A variable set in the Pages dashboard (Settings → Variables and Secrets)
# overrides the same name here. A value written as <something> is a placeholder and counts as not set.

# the token: same values as the Worker's TOKEN_CONTRACT / TOKEN_SYMBOL
VITE_TOKEN_CONTRACT=<your-token-contract>
VITE_TOKEN_SYMBOL=DCA
# mainnet or testnet (NEARBlocks links)
VITE_NEAR_NETWORK=mainnet
# where "Buy" sends people; {token} is replaced with the contract. Placeholder = the Rhea swap page
VITE_BUY_URL=<custom-buy-link>
# social links in the footer; placeholders hide them
VITE_TWITTER_URL=<x-profile-url>
VITE_TELEGRAM_URL=<telegram-url>
# the engine's address. Empty = same site: /api is forwarded to the engine Worker by the Pages Function
VITE_API_URL=
